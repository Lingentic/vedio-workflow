{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server.ts", "lib/**/*.ts", "public/**/*.ts", "tests/**/*.ts"]
}
