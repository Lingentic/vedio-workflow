{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server.ts", "lib/**/*.ts", "public/**/*.ts", "tests/**/*.ts"]
}
